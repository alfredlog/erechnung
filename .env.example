APP_NAME=E-Rechnung Agent
# Public address of the product (dedicated domain), used in links
BASE_URL=https://erechnungagent.de
# Long random value: openssl rand -hex 32   (encrypts stored mailbox passwords; never change it later)
SECRET_KEY=change-me
COOKIE_SECURE=true
ALLOW_REGISTRATION=true

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://erechnung:change-me@db:5432/erechnung
MAX_UPLOAD_MB=15

# Optional: LLM for reading PDF/scan invoices (OpenAI-compatible API). Without a key the
# rule-based reader is used. Mistral is hosted in the EU.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-small-latest

IMAP_POLL_MINUTES=10
# Receiving addresses for customers: <firma>-xxxxxx@INBOUND_DOMAIN (MX record → this server)
INBOUND_DOMAIN=eingang.erechnungagent.de
# Sending invoices by e-mail (IONOS mailbox). Without SMTP_HOST the "send" button is hidden.
SMTP_HOST=smtp.ionos.de
SMTP_OUT_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=rechnungen@erechnungagent.de
SMTP_PASSWORD=
MAIL_FROM=rechnungen@erechnungagent.de
MAX_MAILS_PER_DAY=50
# Operator (Impressum, Datenschutz, AGB, AVV). Only in .env on the server, not in Git.
OPERATOR_NAME=
OPERATOR_STREET=
OPERATOR_CITY=
OPERATOR_EMAIL=info@erechnungagent.de
OPERATOR_PHONE=
OPERATOR_SMALL_BUSINESS=true
